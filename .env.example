# Copy to backend/.env for local development. Never commit real values.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite locally. Docker Compose sets a PostgreSQL URL.
# Production (Supabase pooler): postgres://USER:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Leave empty locally (Celery runs tasks inline, cache in memory).
REDIS_URL=

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email: console locally. In production set the four EmailJS values (server-side private key).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Production only
# DJANGO_SETTINGS_MODULE=config.settings.production
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-3
# CLIENT_IP_META_KEY=HTTP_CF_CONNECTING_IP
# REFRESH_COOKIE_DOMAIN=
# SENTRY_DSN=
